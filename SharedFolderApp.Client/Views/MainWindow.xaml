<Window x:Name="mainForm" x:Class="SharedFolderApp.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SharedFolderApp.Client"
        mc:Ignorable="d"
        Title="Серверный проводник" Height="450" Width="800" MinHeight="300" MinWidth="500" Loaded="mainForm_Loaded">

    <Window.Resources>
        <Style x:Key="PathButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="25"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <TextBox x:Name="serverIpTb" HorizontalAlignment="Left"
                     Margin="10,5,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
            <Button x:Name="connectButton" Content="Подключиться" 
                    HorizontalAlignment="Left" Margin="135,5,0,0" VerticalAlignment="Top" Click="connectButton_Click"/>
            <Label x:Name="connectionStatusLabel" Content="" HorizontalAlignment="Left" 
                   Margin="225,3,0,0" VerticalAlignment="Top"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="3"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" x:Name="serverPathScrollViewer"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Disabled">
                <StackPanel x:Name="serverPathPanel" Orientation="Horizontal" Background="LightGray"/>
            </ScrollViewer>
            <ScrollViewer Grid.Column="2" x:Name="clientPathScrollViewer"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Disabled">
                <StackPanel x:Name="clientPathPanel" Orientation="Horizontal" Background="LightGray"/>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="175"/>
                <ColumnDefinition Width="3"/>
                <ColumnDefinition Width="*" MinWidth="175"/>
            </Grid.ColumnDefinitions>

            <ListView Grid.Row="1" Grid.Column="0" x:Name="serverExplorer" 
                      MouseDoubleClick="serverExplorer_MouseDoubleClick" IsEnabled="False"
                      SelectionMode="Extended" SelectionChanged="serverExplorer_SelectionChanged">

                <ListView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Обновить" Click="RefreshServerExplorer_Click"/>
                        <Separator/>
                        <MenuItem Header="Посмотреть" x:Name="openServerButton" Click="OpenServer_Click"
                                  IsEnabled="False"/>
                        <MenuItem Header="Создать">
                            <MenuItem Header="Папка" Click="CreateFolderServer_Click"/>
                            <MenuItem Header="Файл" Click="CreateFileServer_Click"/>
                        </MenuItem>
                        <MenuItem Header="Переименовать" x:Name="renameServerButton" Click="RenameServer_Click"
                                  IsEnabled="False"/>
                        <MenuItem Header="Удалить" x:Name="deleteServerButton" Click="DeleteServer_Click"
                                  IsEnabled="False"/>
                        <Separator/>
                        <MenuItem Header="Скачать" x:Name="downloadServerButton" Click="Download_Click"
                                  IsEnabled="False"/>
                    </ContextMenu>
                </ListView.ContextMenu>

                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Имя" DisplayMemberBinding="{Binding Name}" Width="100" />
                        <GridViewColumn Header="Тип" DisplayMemberBinding="{Binding Type}" Width="50"/>
                        <GridViewColumn Header="Дата изменения" 
                                        DisplayMemberBinding="{Binding LastModified, StringFormat={}{0:dd-MM-yyyy HH\\:mm}}" Width="120"/>
                        <GridViewColumn Header="Размер" DisplayMemberBinding="{Binding FormattedSize}" Width="75"/>
                    </GridView>
                </ListView.View>
            </ListView>

            <GridSplitter Grid.Column="1" Width="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

            <ListView Grid.Row="1" Grid.Column="2" x:Name="clientExplorer" 
                      MouseDoubleClick="clientExplorer_MouseDoubleClick"
                      SelectionMode="Extended" SelectionChanged="clientExplorer_SelectionChanged">

                <ListView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Обновить" Click="RefreshClientExplorer_Click"/>
                        <MenuItem Header="Открыть в проводнике" Click="OpenInExplorer_Click"/>
                        <Separator/>
                        <MenuItem Header="Открыть" x:Name="openClientButton" Click="OpenClient_Click"
                                  IsEnabled="False"/>
                        <MenuItem Header="Создать">
                            <MenuItem Header="Папка" Click="CreateFolderClient_Click"/>
                            <MenuItem Header="Файл" Click="CreateFileClient_Click"/>
                        </MenuItem>
                        <MenuItem Header="Переименовать" x:Name="renameClientButton" Click="RenameClient_Click"
                                  IsEnabled="False"/>
                        <MenuItem Header="Удалить" x:Name="deleteClientButton" Click="DeleteClient_Click"
                                  IsEnabled="False"/>
                        <Separator/>
                        <MenuItem Header="Копировать на сервер" x:Name="uploadClientButton" Click="Upload_Click"
                                  IsEnabled="False"/>
                    </ContextMenu>
                </ListView.ContextMenu>
                
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Имя" DisplayMemberBinding="{Binding Name}" Width="100"/>
                        <GridViewColumn Header="Тип" DisplayMemberBinding="{Binding Type}" Width="50"/>
                        <GridViewColumn Header="Дата изменения" 
                                        DisplayMemberBinding="{Binding LastModified, StringFormat={}{0:dd-MM-yyyy HH\\:mm}}" Width="120"/>
                        <GridViewColumn Header="Размер" DisplayMemberBinding="{Binding FormattedSize}" Width="75"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>
        
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Label Grid.Column="0" x:Name="uploadStatusLabel" Content="" HorizontalAlignment="Right" Margin="0, 0, 155, 0"
                   FontSize="10" Visibility="Collapsed"/>
            <ProgressBar Grid.Column="0" x:Name="uploadProgressBar" Minimum="0" Maximum="100"
                         Height="15" Margin="3" Width="150" HorizontalAlignment="Right"
                         Visibility="Collapsed"/>

            <Label Grid.Column="1" x:Name="downloadStatusLabel" Content="" HorizontalAlignment="Right" Margin="0, 0, 155, 0"
                   FontSize="10" Visibility="Collapsed"/>
            <ProgressBar Grid.Column="1" x:Name="downloadProgressBar" Minimum="0" Maximum="100" 
                         Height="15" Margin="3" Width="150" HorizontalAlignment="Right"
                         Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Window>

<Window x:Name="renameWindow" x:Class="SharedFolderApp.Client.Views.InputNameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SharedFolderApp.Client.Views"
        mc:Ignorable="d"
        Title="Переименовать" Height="115" Width="208" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <Grid>
        <TextBox x:Name="renameTextBox" HorizontalAlignment="Center" Margin="0,10,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="188" KeyDown="renameTextBox_KeyDown"/>
        <Button x:Name="renameButton" Content="Сохранить" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0" Click="renameButton_Click"/>

    </Grid>
</Window>
